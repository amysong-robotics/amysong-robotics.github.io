{% comment %}
  Unified projects entry renderer for both formats.
  Keep the CV projects section concise by showing project names only.
{% endcomment %}

<ul class="card-text font-weight-light list-group list-group-flush cv-projects-simple">
  {% for entry in entries %}
    <li class="list-group-item">
      {% if entry.url %}
        <h6 class="title font-weight-bold mb-0">
          <a href="{{ entry.url }}" target="_blank">{{ entry.name }}</a>
        </h6>
      {% else %}
        <h6 class="title font-weight-bold mb-0">{{ entry.name }}</h6>
      {% endif %}
    </li>
  {% endfor %}
</ul>
